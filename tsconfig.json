{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "tests", "vitest.config.ts"],
  // 浏览器侧（表现层、场景、界面、音频）要 DOM 类型，单独由 tsconfig.web.json 检查；引擎和命令行这里不带 DOM
  "exclude": ["src/app", "src/presentation", "src/scene", "src/ui", "src/audio", "src/assets", "tests/presentation*.test.ts"]
}
