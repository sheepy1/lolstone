{
  "name": "melol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "play": "tsx src/cli/play.ts",
    "smoke": "tsx src/cli/play.ts --auto --games 200",
    "arena": "tsx src/cli/arena.ts",
    "fetch:art": "node scripts/fetch-art.ts",
    "fetch:voice": "node scripts/fetch-voice.ts",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build",
    "preview": "vite preview",
    "fixture:record": "MELOL_RECORD_FIXTURE=1 vitest run tests/presentation-fixture.test.ts",
    "font:subset": "tsx src/dev/subsetFont.ts"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lil-gui": "^0.21.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "troika-three-text": "^0.52.5"
  }
